; Engine configuration file.
; Open this folder in Godot 4.3 or later to run the demo and tests.

config_version=5

[application]

config/name="Godot Effects System"
config/description="Status effects, stat modifiers and game-feel cues for Godot 4."
run/main_scene="res://demo/demo.tscn"
config/features=PackedStringArray("4.3")

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
