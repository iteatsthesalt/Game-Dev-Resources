{
  "name": "tactilume-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tactilume Desktop: a GPU light show played with phones, gamepads and sound",
  "author": "Tactilume",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "start": "node tools/build.mjs && electron .",
    "unit": "node --test \"tests/unit/*.test.js\"",
    "e2e": "node tests/e2e/run.js",
    "test": "npm run build && npm run unit && npm run e2e",
    "smoke": "electron . --smoke",
    "dist": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0"
  }
}
