<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. Saved scenes and settings live in the page's storage inside
     app_webview, so they come along to a new phone. WebView's shader cache is rebuilt anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/Default/GPUCache/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/Default/GPUCache/" />
    </device-transfer>
</data-extraction-rules>
