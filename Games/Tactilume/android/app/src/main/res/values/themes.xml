<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Black everywhere, from the first frame: the launch window, the space behind the page,
         and the bars, so nothing white ever flashes before the light appears. The versioned
         folders (values-v28 and up) add what newer Android versions understand. -->
    <style name="Base.Theme.Tactilume" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:colorAccent">@color/notice_accent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Platform.Theme.Tactilume" parent="Base.Theme.Tactilume" />

    <style name="Theme.Tactilume" parent="Platform.Theme.Tactilume" />
</resources>
